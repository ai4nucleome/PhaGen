# Evaluation data: keep preprocessing code and data-source documentation.
/evaluation/**/data/**
!/evaluation/**/data/**/
!/evaluation/**/data/**/*.py
!/evaluation/**/data/**/*.sh
!/evaluation/**/data/**/*.bash
!/evaluation/**/data/**/*.R
!/evaluation/**/data/**/README.md
!/evaluation/**/data/**/requirements*.txt

# Evaluation outputs, feature caches, checkpoints, and experiment archives.
/evaluation/**/results*/
/evaluation/**/outputs/
/evaluation/**/working/
/evaluation/**/work/
/evaluation/**/logs*/
/evaluation/**/feature_cache/
/evaluation/**/embeddings/
/evaluation/**/cache/
/evaluation/**/checkpoints/
/evaluation/**/.trash/
/evaluation/**/.bak/
/evaluation/**/archive/
/evaluation/**/archives/

# Data and result files stored outside the standard output directories.
